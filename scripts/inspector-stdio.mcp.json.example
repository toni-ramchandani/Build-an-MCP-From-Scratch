{
  "mcpServers": {
    "build-an-mcp-server": {
      "type": "stdio",
      "command": "python",
      "args": ["-m", "build_an_mcp_server.server"],
      "env": {
        "ENABLE_FILESYSTEM": "true",
        "FS_ALLOWED_DIRS": "/absolute/path/to/.mcp-smoke",
        "READ_ONLY": "true",
        "ENABLE_GITHUB": "false",
        "ENABLE_BROWSER": "false"
      }
    }
  }
}
