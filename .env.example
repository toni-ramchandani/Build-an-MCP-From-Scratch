# Server identity
SERVER_NAME="Build an MCP from Scratch"

# Filesystem capability
ENABLE_FILESYSTEM=true
FS_ALLOWED_DIRS=.
READ_ONLY=false

# GitHub capability
# Keep disabled unless you have a valid GitHub token and enable the adapter.
ENABLE_GITHUB=false
GITHUB_TOKEN=

# Browser capability
# Keep disabled unless you explicitly want to run Playwright-backed tools.
ENABLE_BROWSER=false
