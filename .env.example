# Safe local defaults. Copy this file to .env and set at least one explicit
# workspace root before starting the server.
MCP_SERVER_NAME="Build an MCP from Scratch"
MCP_ENABLE_WORKSPACE=true

# Absolute roots separated by the platform path separator (":" on POSIX,
# ";" on Windows). The public MCP surface uses root-1, root-2, ... and never
# exposes these absolute paths.
MCP_WORKSPACE_ROOTS=

# Additional capability groups are absent from discovery unless explicitly
# enabled. Mutation remains disabled throughout the early book chapters.
MCP_ENABLE_GITHUB=false
MCP_GITHUB_TOKEN=
MCP_GITHUB_REPOSITORIES=
MCP_GITHUB_TIMEOUT_SECONDS=10

MCP_ENABLE_MUTATION=false

MCP_ENABLE_BROWSER=false
# Comma-separated exact origins, for example https://example.com.
MCP_BROWSER_ALLOWED_ORIGINS=
MCP_BROWSER_MAX_HANDLES=4
MCP_BROWSER_HANDLE_TTL_SECONDS=300
MCP_BROWSER_NAVIGATION_TIMEOUT_MS=10000

# The repository-owned HTTP entry point is deliberately loopback-only.
MCP_HTTP_HOST=127.0.0.1
MCP_HTTP_PORT=8000
# The packaged command intentionally has no built-in production token verifier.
# Authenticated loopback HTTP must supply one through create_http_app(). Remote
# binding remains rejected until an explicit deployment Origin/Host policy exists.
MCP_HTTP_REQUIRE_AUTH=false
# Example deployment values (uncomment only with an application TokenVerifier):
# MCP_AUTH_ISSUER_URL=https://auth.example.com
# MCP_AUTH_RESOURCE_URL=https://mcp.example.com/mcp
# MCP_AUTH_REQUIRED_SCOPES=workspace:read
# The candidate write operation additionally challenges for workspace:write.

# Public result budgets. Keep these values unless a chapter explicitly asks
# you to inspect the trade-off.
MCP_MAX_FILE_READ_BYTES=65536
MCP_MAX_DIRECTORY_ENTRIES=200
MCP_MAX_WRITE_BYTES=65536
MCP_MAX_GITHUB_BODY_CHARS=12000
MCP_MAX_BROWSER_TEXT_CHARS=32768
MCP_MAX_HTTP_REQUEST_BYTES=1048576

MCP_LOG_LEVEL=INFO
