# Server identity
SERVER_NAME="Build an MCP from Scratch"

# Filesystem capability
ENABLE_FILESYSTEM=true

# FS_ALLOWED_DIRS must be an absolute path.
# macOS/Linux example:
# FS_ALLOWED_DIRS=/Users/you/projects/Build-an-MCP-From-Scratch
# Windows example:
# FS_ALLOWED_DIRS=C:\Users\you\projects\Build-an-MCP-From-Scratch
FS_ALLOWED_DIRS=

READ_ONLY=false

# GitHub capability
# Keep disabled unless you have a valid GitHub token and enable the adapter.
ENABLE_GITHUB=false
GITHUB_TOKEN=

# Web search capability
# Keep disabled unless you have a Tavily API key.
ENABLE_WEB_SEARCH=false
TAVILY_API_KEY=

# Browser capability
# Keep disabled unless you explicitly want to run Playwright-backed tools.
ENABLE_BROWSER=false
